# --- Database (docker-compose: xirman_docs_db) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=xirman
DB_PASSWORD=xirman
DB_DATABASE=xirman_docs

# --- Redis (docker-compose: xirman_docs_redis) ---
# MailModule yalnız REDIS_URL varsa Redis-ə qoşulur — bunu mütləq doldurun,
# əks halda e-mail növbəsi işləməyəcək.
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=7d

# --- Mail (Brevo) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# --- App ---
PORT=3000
# Paylaşım linkləri bu ünvanla qurulur — production-da real domen olmalıdır.
BACKEND_URL=http://localhost:3000
